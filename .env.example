# Copy to .env. Everything works offline with the heuristic planner —
# no LLM key is required to run the demo, the API, or the eval suite.

# Planner: "heuristic" (offline, deterministic) or "llm"
PLANNER=heuristic

# LLM (only when PLANNER=llm) — Azure OpenAI or OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
OPENAI_API_KEY=

# LangSmith tracing (optional — leave blank to disable)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-web-search-service

# Browser
HEADLESS=true
ACTION_TIMEOUT_MS=3000

# Service
HOST=0.0.0.0
PORT=8000
